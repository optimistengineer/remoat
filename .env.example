# ── Telegram ──────────────────────────────────────────────
# Create a bot: message @BotFather on Telegram → /newbot → copy the token
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your Telegram user ID (comma-separated for multiple users)
# Find yours: message @userinfobot on Telegram
ALLOWED_USER_IDS=123456789

# ── Workspace ─────────────────────────────────────────────
# Parent directory containing your coding projects
WORKSPACE_BASE_DIR=~/Code

# ── Forum Topics ──────────────────────────────────────────
# Use Telegram Forum Topics for per-project isolation
# Requires a supergroup with Topics enabled in group settings
USE_TOPICS=true

# ── Antigravity ───────────────────────────────────────────
# (Optional) Full path to the Antigravity executable.
# Only needed if Antigravity is installed outside the standard locations —
# Remoat already probes both product names (v1 "Antigravity" and v2
# "Antigravity IDE") on every platform and uses the first one that exists.
#
# IMPORTANT: dotenv reads this value LITERALLY. Do NOT wrap it in quotes, even
# when the path contains spaces — the quotes would become part of the path.
#
# Windows (Antigravity IDE v2 — note the spaces):
# ANTIGRAVITY_PATH=C:\Users\you\AppData\Local\Programs\Antigravity IDE\Antigravity IDE.exe
# Windows (Antigravity v1):
# ANTIGRAVITY_PATH=C:\Users\you\AppData\Local\Programs\Antigravity\Antigravity.exe
# macOS: normally leave this UNSET. `remoat open` launches the app bundle with
# `open -a`, which finds it wherever LaunchServices registered it, and macOS does
# NOT use the "Antigravity IDE" name — the bundle is still Antigravity.app
# (verified on 2.0.10). Setting this forces a direct-binary launch instead:
# ANTIGRAVITY_PATH=/Applications/Antigravity.app/Contents/MacOS/Antigravity
# Linux (AppImage):
# ANTIGRAVITY_PATH=/opt/applications/antigravity.AppImage

# ── Behavior ──────────────────────────────────────────────
# Auto-approve file edit dialogs (can be toggled at runtime via /autoaccept)
AUTO_APPROVE_FILE_EDITS=false

# ── Advanced ─────────────────────────────────────────────
# Log verbosity: debug, info, warn, error (default: info)
# LOG_LEVEL=info

# DOM extraction mode: structured, legacy (default: structured)
# EXTRACTION_MODE=structured
